<configuration>
  <appender name="SYSLOG" class="org.red5.logback.syslog.SyslogAppender">
    <syslogHost>127.0.0.1</syslogHost>
    <port>15174</port>
    <sync>true</sync>
    <suffixPattern>%msg</suffixPattern>
    <modifier class="org.red5.syslog.impl.message.modifier.escape.HTMLEntityEscapeSyslogMessageModifier"/>
    <modifier class="org.red5.syslog.impl.message.modifier.text.SuffixSyslogMessageModifier">
      <suffix>END</suffix>
    </modifier>
  </appender>
  <root level="INFO"><appender-ref ref="SYSLOG"/></root>
</configuration>
